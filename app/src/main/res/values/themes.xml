<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aghour" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_light</item>
    </style>

    <!-- Android 12+ splash API (backported by core-splashscreen) -->
    <style name="Theme.Aghour.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Aghour</item>
    </style>
</resources>
